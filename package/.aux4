    {
      "name": "queue:repository",
      "commands": [
        {
          "name": "start",
          "execute": [
            "log:repository storage ready (db=${db}); no server process needed"
          ],
          "private": true,
          "help": {
            "text": "repository storage: validate readiness (no server process)",
            "variables": [
              {
                "name": "db",
                "text": "Database path or libsql:// URL",
                "default": ".queue.db"
              }
            ]
          }
        },
        {
          "name": "stop",
          "execute": [
            "log:repository storage: nothing to stop"
          ],
          "private": true,
          "help": {
            "text": "repository storage: no-op"
          }
        },
        {
          "name": "create",
          "execute": [
            "set:createData={\"workQueue\":${workQueue},\"maxAttempts\":${maxAttempts}}",
            "aux4 repository write _queues --db value(db) --id value(name) --data value(createData)"
          ],
          "private": true,
          "help": {
            "text": "repository storage: create a queue record",
            "variables": [
              {
                "name": "db",
                "text": "Database path or libsql:// URL",
                "default": ".queue.db"
              },
              {
                "name": "name",
                "text": "Queue name",
                "default": ""
              },
              {
                "name": "workQueue",
                "text": "Opt this queue into work-queue semantics",
                "default": "false"
              },
              {
                "name": "maxAttempts",
                "text": "Maximum delivery attempts before dead-lettering",
                "default": "0"
              }
            ]
          }
        },
        {
          "name": "delete",
          "execute": [
            "nout:${packageDir}/aux4-queue table-name values(name)",
            "set:table=${response}",
            "aux4 repository drop value(table) --db value(db) --yes true",
            "aux4 repository delete _queues --db value(db) --id value(name)"
          ],
          "private": true,
          "help": {
            "text": "repository storage: delete a queue's messages table and its record",
            "variables": [
              {
                "name": "db",
                "text": "Database path or libsql:// URL",
                "default": ".queue.db"
              },
              {
                "name": "name",
                "text": "Queue name",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "list",
          "execute": [
            "aux4 repository find _queues --db value(db) --expr \"1=1\""
          ],
          "private": true,
          "help": {
            "text": "repository storage: list queue records",
            "variables": [
              {
                "name": "db",
                "text": "Database path or libsql:// URL",
                "default": ".queue.db"
              }
            ]
          }
        },
        {
          "name": "send",
          "execute": [
            "nout:${packageDir}/aux4-queue table-name values(name)",
            "set:table=${response}",
            "nout:stdin:cat",
            "set:queueData={\"body\":${response},\"group\":\"${group}\",\"attempts\":0}",
            "aux4 repository write value(table) --db value(db) --data value(queueData)"
          ],
          "private": true,
          "help": {
            "text": "repository storage: write a message record, wrapping the stdin payload as its body",
            "variables": [
              {
                "name": "db",
                "text": "Database path or libsql:// URL",
                "default": ".queue.db"
              },
              {
                "name": "name",
                "text": "Queue name",
                "default": ""
              },
              {
                "name": "group",
                "text": "Group key for one-at-a-time delivery",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "lease",
          "execute": [
            "nout:${packageDir}/aux4-queue table-name values(name)",
            "set:table=${response}",
            "set:leaseExpr=${maxAttempts} <= 0 or attempts < ${maxAttempts}",
            "aux4 repository lease value(table) --db value(db) --expr value(leaseExpr) --group group --ttl value(visibility) --owner value(owner) --raw false"
          ],
          "private": true,
          "help": {
            "text": "repository storage: lease the next eligible message",
            "variables": [
              {
                "name": "db",
                "text": "Database path or libsql:// URL",
                "default": ".queue.db"
              },
              {
                "name": "name",
                "text": "Queue name",
                "default": ""
              },
              {
                "name": "visibility",
                "text": "Visibility timeout in seconds",
                "default": "30"
              },
              {
                "name": "owner",
                "text": "Opaque identifier of the leasing caller",
                "default": ""
              },
              {
                "name": "maxAttempts",
                "text": "Exclude messages that already reached this many attempts",
                "default": "0"
              }
            ]
          }
        },
        {
          "name": "renew",
          "execute": [
            "nout:${packageDir}/aux4-queue table-name values(name)",
            "set:table=${response}",
            "aux4 repository renew value(table) --db value(db) --id value(id) --ttl value(visibility)"
          ],
          "private": true,
          "help": {
            "text": "repository storage: extend a still-live lease",
            "variables": [
              {
                "name": "db",
                "text": "Database path or libsql:// URL",
                "default": ".queue.db"
              },
              {
                "name": "name",
                "text": "Queue name",
                "default": ""
              },
              {
                "name": "id",
                "text": "The message id returned by 'queue lease'",
                "default": ""
              },
              {
                "name": "visibility",
                "text": "New visibility timeout in seconds, counted from now",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "ack",
          "execute": [
            "nout:${packageDir}/aux4-queue table-name values(name)",
            "set:table=${response}",
            "aux4 repository delete value(table) --db value(db) --id value(id)"
          ],
          "private": true,
          "help": {
            "text": "repository storage: delete a completed message",
            "variables": [
              {
                "name": "db",
                "text": "Database path or libsql:// URL",
                "default": ".queue.db"
              },
              {
                "name": "name",
                "text": "Queue name",
                "default": ""
              },
              {
                "name": "id",
                "text": "The message id returned by 'queue lease'",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "nack",
          "execute": [
            "nout:${packageDir}/aux4-queue table-name values(name)",
            "set:table=${response}",
            "aux4 repository patch value(table) --db value(db) --id value(id) --data '{\"leaseExpiresAt\":0}' --increment attempts"
          ],
          "private": true,
          "help": {
            "text": "repository storage: release a leased message and bump attempts (server-side increment, no shell arithmetic)",
            "variables": [
              {
                "name": "db",
                "text": "Database path or libsql:// URL",
                "default": ".queue.db"
              },
              {
                "name": "name",
                "text": "Queue name",
                "default": ""
              },
              {
                "name": "id",
                "text": "The message id returned by 'queue lease'",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "dlq",
          "execute": [
            "nout:${packageDir}/aux4-queue table-name values(name)",
            "set:table=${response}",
            "set:dlqExpr=${maxAttempts} > 0 and attempts >= ${maxAttempts}",
            "aux4 repository find value(table) --db value(db) --expr value(dlqExpr)"
          ],
          "private": true,
          "help": {
            "text": "repository storage: list dead-letter messages",
            "variables": [
              {
                "name": "db",
                "text": "Database path or libsql:// URL",
                "default": ".queue.db"
              },
              {
                "name": "name",
                "text": "Queue name",
                "default": ""
              },
              {
                "name": "maxAttempts",
                "text": "The queue's maxAttempts",
                "default": "0"
              }
            ]
          }
        }
      ]
    }
  ]
}
