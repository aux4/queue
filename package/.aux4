{
  "scope": "aux4",
  "name": "queue",
  "version": "0.2.3",
  "description": "in-memory message queue with pub/sub support, plus a durable work-queue mode",
  "license": "Apache-2.0",
  "tags": [
    "aux4",
    "queue",
    "pubsub",
    "messaging"
  ],
  "dependencies": [
    "aux4/repository@>=1.3.9"
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "queue",
          "execute": [
            "profile:queue"
          ],
          "help": {
            "text": "in-memory message queue with pub/sub support, plus a durable work-queue mode"
          }
        }
      ]
    },
    {
      "name": "queue",
      "commands": [
        {
          "name": "memory",
          "execute": [
            "profile:queue:memory"
          ],
          "private": true,
          "help": {
            "text": "memory storage dispatch target (internal)"
          }
        },
        {
          "name": "repository",
          "execute": [
            "profile:queue:repository"
          ],
          "private": true,
          "help": {
            "text": "repository storage dispatch target (internal)"
          }
        },
        {
          "name": "start",
          "execute": [
            "set:provider=nvl(storage, provider)",
            "nout:aux4 queue value(provider) --help > /dev/null 2>&1; echo $?",
            "set:providerOk=${response}",
            "if(providerOk!=0) && echo 'Error: queue provider 'value(provider)' is not installed or unknown. Run: aux4 aux4 pkger install aux4/queue-'value(provider)' (or use --provider memory|repository|sqs).' >&2 && exit 1 || true",
            "aux4 queue value(provider) start param(port) param(token) param(queues) param(db)"
          ],
          "help": {
            "text": "Start the queue server (memory storage) or validate repository storage is reachable (no server process)",
            "variables": [
              {
                "name": "provider",
                "text": "Queue provider: memory (default, volatile, in-process pub/sub + work queues), repository (durable, every command talks to the database directly, no server process), or sqs (durable, delegates to Amazon SQS via the aux4/queue-sqs plugin). Unknown or not-installed providers (including the reserved 'cloud' provider from aux4/queue-cloud) fail with an 'install aux4/queue-<provider>' error",
                "default": "memory",
                "options": [
                  "memory",
                  "repository",
                  "sqs",
                  "cloud"
                ]
              },
              {
                "name": "storage",
                "text": "Deprecated alias for --provider, kept for backward compatibility. --provider takes precedence when both are given",
                "default": ""
              },
              {
                "name": "db",
                "text": "Database path or libsql:// URL, only used when --storage repository",
                "default": ".queue.db"
              },
              {
                "name": "port",
                "text": "Server port (memory storage only)",
                "default": "8420"
              },
              {
                "name": "token",
                "text": "Authentication token (memory storage only)",
                "default": ""
              },
              {
                "name": "queues",
                "text": "Pre-configured queues (JSON array, memory storage only)",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "stop",
          "execute": [
            "set:provider=nvl(storage, provider)",
            "nout:aux4 queue value(provider) --help > /dev/null 2>&1; echo $?",
            "set:providerOk=${response}",
            "if(providerOk!=0) && echo 'Error: queue provider 'value(provider)' is not installed or unknown. Run: aux4 aux4 pkger install aux4/queue-'value(provider)' (or use --provider memory|repository|sqs).' >&2 && exit 1 || true",
            "aux4 queue value(provider) stop param(port)"
          ],
          "help": {
            "text": "Stop the queue server (memory storage only; a no-op for repository storage)",
            "variables": [
              {
                "name": "provider",
                "text": "Queue provider: memory (default, volatile, in-process pub/sub + work queues), repository (durable, every command talks to the database directly, no server process), or sqs (durable, delegates to Amazon SQS via the aux4/queue-sqs plugin). Unknown or not-installed providers (including the reserved 'cloud' provider from aux4/queue-cloud) fail with an 'install aux4/queue-<provider>' error",
                "default": "memory",
                "options": [
                  "memory",
                  "repository",
                  "sqs",
                  "cloud"
                ]
              },
              {
                "name": "storage",
                "text": "Deprecated alias for --provider, kept for backward compatibility. --provider takes precedence when both are given",
                "default": ""
              },
              {
                "name": "port",
                "text": "Server port",
                "default": "8420"
              }
            ]
          }
        },
        {
          "name": "create",
          "execute": [
            "set:provider=nvl(storage, provider)",
            "nout:aux4 queue value(provider) --help > /dev/null 2>&1; echo $?",
            "set:providerOk=${response}",
            "if(providerOk!=0) && echo 'Error: queue provider 'value(provider)' is not installed or unknown. Run: aux4 aux4 pkger install aux4/queue-'value(provider)' (or use --provider memory|repository|sqs).' >&2 && exit 1 || true",
            "aux4 queue value(provider) create param(port) param(token) param(name) param(ws) param(webhook) param(header**) param(workQueue) param(maxAttempts) param(db)"
          ],
          "help": {
            "text": "Create a new queue. In repository storage, every queue is implicitly a durable work queue (there is no pub/sub concept without a server process)",
            "variables": [
              {
                "name": "provider",
                "text": "Queue provider: memory (default, volatile, in-process pub/sub + work queues), repository (durable, every command talks to the database directly, no server process), or sqs (durable, delegates to Amazon SQS via the aux4/queue-sqs plugin). Unknown or not-installed providers (including the reserved 'cloud' provider from aux4/queue-cloud) fail with an 'install aux4/queue-<provider>' error",
                "default": "memory",
                "options": [
                  "memory",
                  "repository",
                  "sqs",
                  "cloud"
                ]
              },
              {
                "name": "storage",
                "text": "Deprecated alias for --provider, kept for backward compatibility. --provider takes precedence when both are given",
                "default": ""
              },
              {
                "name": "db",
                "text": "Database path or libsql:// URL, only used when --storage repository",
                "default": ".queue.db"
              },
              {
                "name": "port",
                "text": "Server port (memory storage only)",
                "default": "8420"
              },
              {
                "name": "token",
                "text": "Authentication token (memory storage only)",
                "default": ""
              },
              {
                "name": "name",
                "text": "Queue name",
                "default": ""
              },
              {
                "name": "ws",
                "text": "WebSocket URL to proxy messages to (memory storage, pub/sub mode only)",
                "default": ""
              },
              {
                "name": "webhook",
                "text": "Webhook URL to proxy messages to (memory storage, pub/sub mode only)",
                "default": ""
              },
              {
                "name": "header",
                "text": "HTTP header for WS/webhook (format: Key: Value) (memory storage, pub/sub mode only)",
                "default": "",
                "multiple": true
              },
              {
                "name": "workQueue",
                "text": "Opt this queue into work-queue semantics (ack/nack/lease) instead of pub/sub fan-out (memory storage only; always true in repository storage)",
                "default": "false"
              },
              {
                "name": "maxAttempts",
                "text": "Maximum delivery attempts before a message is moved to the dead-letter queue. 0 (default) means unlimited",
                "default": "0"
              }
            ]
          }
        },
        {
          "name": "delete",
          "execute": [
            "set:provider=nvl(storage, provider)",
            "nout:aux4 queue value(provider) --help > /dev/null 2>&1; echo $?",
            "set:providerOk=${response}",
            "if(providerOk!=0) && echo 'Error: queue provider 'value(provider)' is not installed or unknown. Run: aux4 aux4 pkger install aux4/queue-'value(provider)' (or use --provider memory|repository|sqs).' >&2 && exit 1 || true",
            "aux4 queue value(provider) delete param(port) param(token) param(name) param(db)"
          ],
          "help": {
            "text": "Delete a queue",
            "variables": [
              {
                "name": "provider",
                "text": "Queue provider: memory (default, volatile, in-process pub/sub + work queues), repository (durable, every command talks to the database directly, no server process), or sqs (durable, delegates to Amazon SQS via the aux4/queue-sqs plugin). Unknown or not-installed providers (including the reserved 'cloud' provider from aux4/queue-cloud) fail with an 'install aux4/queue-<provider>' error",
                "default": "memory",
                "options": [
                  "memory",
                  "repository",
                  "sqs",
                  "cloud"
                ]
              },
              {
                "name": "storage",
                "text": "Deprecated alias for --provider, kept for backward compatibility. --provider takes precedence when both are given",
                "default": ""
              },
              {
                "name": "db",
                "text": "Database path or libsql:// URL, only used when --storage repository",
                "default": ".queue.db"
              },
              {
                "name": "port",
                "text": "Server port (memory storage only)",
                "default": "8420"
              },
              {
                "name": "token",
                "text": "Authentication token (memory storage only)",
                "default": ""
              },
              {
                "name": "name",
                "text": "Queue name",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "list",
          "execute": [
            "set:provider=nvl(storage, provider)",
            "nout:aux4 queue value(provider) --help > /dev/null 2>&1; echo $?",
            "set:providerOk=${response}",
            "if(providerOk!=0) && echo 'Error: queue provider 'value(provider)' is not installed or unknown. Run: aux4 aux4 pkger install aux4/queue-'value(provider)' (or use --provider memory|repository|sqs).' >&2 && exit 1 || true",
            "aux4 queue value(provider) list param(port) param(token) param(db)"
          ],
          "help": {
            "text": "List all queues",
            "variables": [
              {
                "name": "provider",
                "text": "Queue provider: memory (default, volatile, in-process pub/sub + work queues), repository (durable, every command talks to the database directly, no server process), or sqs (durable, delegates to Amazon SQS via the aux4/queue-sqs plugin). Unknown or not-installed providers (including the reserved 'cloud' provider from aux4/queue-cloud) fail with an 'install aux4/queue-<provider>' error",
                "default": "memory",
                "options": [
                  "memory",
                  "repository",
                  "sqs",
                  "cloud"
                ]
              },
              {
                "name": "storage",
                "text": "Deprecated alias for --provider, kept for backward compatibility. --provider takes precedence when both are given",
                "default": ""
              },
              {
                "name": "db",
                "text": "Database path or libsql:// URL, only used when --storage repository",
                "default": ".queue.db"
              },
              {
                "name": "port",
                "text": "Server port (memory storage only)",
                "default": "8420"
              },
              {
                "name": "token",
                "text": "Authentication token (memory storage only)",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "send",
          "execute": [
            "set:provider=nvl(storage, provider)",
            "nout:aux4 queue value(provider) --help > /dev/null 2>&1; echo $?",
            "set:providerOk=${response}",
            "if(providerOk!=0) && echo 'Error: queue provider 'value(provider)' is not installed or unknown. Run: aux4 aux4 pkger install aux4/queue-'value(provider)' (or use --provider memory|repository|sqs).' >&2 && exit 1 || true",
            "stdin:aux4 queue value(provider) send param(port) param(token) param(name) param(group) param(id) param(db)"
          ],
          "help": {
            "text": "Send messages to a queue from stdin",
            "variables": [
              {
                "name": "provider",
                "text": "Queue provider: memory (default, volatile, in-process pub/sub + work queues), repository (durable, every command talks to the database directly, no server process), or sqs (durable, delegates to Amazon SQS via the aux4/queue-sqs plugin). Unknown or not-installed providers (including the reserved 'cloud' provider from aux4/queue-cloud) fail with an 'install aux4/queue-<provider>' error",
                "default": "memory",
                "options": [
                  "memory",
                  "repository",
                  "sqs",
                  "cloud"
                ]
              },
              {
                "name": "storage",
                "text": "Deprecated alias for --provider, kept for backward compatibility. --provider takes precedence when both are given",
                "default": ""
              },
              {
                "name": "db",
                "text": "Database path or libsql:// URL, only used when --storage repository",
                "default": ".queue.db"
              },
              {
                "name": "port",
                "text": "Server port (memory storage only)",
                "default": "8420"
              },
              {
                "name": "token",
                "text": "Authentication token (memory storage only)",
                "default": ""
              },
              {
                "name": "name",
                "text": "Queue name",
                "default": ""
              },
              {
                "name": "group",
                "text": "Group key for one-at-a-time (per group) delivery, e.g. a chatId. Only meaningful on a work queue",
                "default": ""
              },
              {
                "name": "id",
                "text": "Message id (memory storage, work-queue mode only; auto-generated when empty)",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "receive",
          "execute": [
            "${packageDir}/aux4-queue receive values(port, token, name, limit)"
          ],
          "help": {
            "text": "Receive messages from a pub/sub queue (memory storage only; streams until --limit messages arrive or the connection closes). For a work queue, use 'queue lease' + 'queue ack'/'queue nack' instead",
            "variables": [
              {
                "name": "port",
                "text": "Server port",
                "default": "8420"
              },
              {
                "name": "token",
                "text": "Authentication token",
                "default": ""
              },
              {
                "name": "name",
                "text": "Queue name",
                "default": ""
              },
              {
                "name": "limit",
                "text": "Max messages to receive (-1 for unlimited)",
                "default": "-1"
              }
            ]
          }
        },
        {
          "name": "lease",
          "execute": [
            "set:provider=nvl(storage, provider)",
            "nout:aux4 queue value(provider) --help > /dev/null 2>&1; echo $?",
            "set:providerOk=${response}",
            "if(providerOk!=0) && echo 'Error: queue provider 'value(provider)' is not installed or unknown. Run: aux4 aux4 pkger install aux4/queue-'value(provider)' (or use --provider memory|repository|sqs).' >&2 && exit 1 || true",
            "aux4 queue value(provider) lease param(port) param(token) param(name) param(visibility) param(owner) param(maxAttempts) param(db)"
          ],
          "help": {
            "text": "Lease the next eligible message from a work queue (visibility-timeout based; one message per group at a time when the message has a group)",
            "variables": [
              {
                "name": "provider",
                "text": "Queue provider: memory (default, volatile, in-process pub/sub + work queues), repository (durable, every command talks to the database directly, no server process), or sqs (durable, delegates to Amazon SQS via the aux4/queue-sqs plugin). Unknown or not-installed providers (including the reserved 'cloud' provider from aux4/queue-cloud) fail with an 'install aux4/queue-<provider>' error",
                "default": "memory",
                "options": [
                  "memory",
                  "repository",
                  "sqs",
                  "cloud"
                ]
              },
              {
                "name": "storage",
                "text": "Deprecated alias for --provider, kept for backward compatibility. --provider takes precedence when both are given",
                "default": ""
              },
              {
                "name": "db",
                "text": "Database path or libsql:// URL, only used when --storage repository",
                "default": ".queue.db"
              },
              {
                "name": "port",
                "text": "Server port (memory storage only)",
                "default": "8420"
              },
              {
                "name": "token",
                "text": "Authentication token (memory storage only)",
                "default": ""
              },
              {
                "name": "name",
                "text": "Queue name",
                "default": ""
              },
              {
                "name": "visibility",
                "text": "Visibility timeout in seconds: how long this lease is held before it expires on its own and becomes eligible again",
                "default": "30"
              },
              {
                "name": "owner",
                "text": "Opaque identifier of the leasing caller (repository storage only)",
                "default": ""
              },
              {
                "name": "maxAttempts",
                "text": "Exclude messages that have already reached this many attempts (repository storage only; 0 means unlimited, as set on 'queue create')",
                "default": "0"
              }
            ]
          }
        },
        {
          "name": "renew",
          "execute": [
            "set:provider=nvl(storage, provider)",
            "nout:aux4 queue value(provider) --help > /dev/null 2>&1; echo $?",
            "set:providerOk=${response}",
            "if(providerOk!=0) && echo 'Error: queue provider 'value(provider)' is not installed or unknown. Run: aux4 aux4 pkger install aux4/queue-'value(provider)' (or use --provider memory|repository|sqs).' >&2 && exit 1 || true",
            "aux4 queue value(provider) renew param(port) param(token) param(name) param(leaseId) param(id) param(visibility) param(db)"
          ],
          "help": {
            "text": "Extend a still-live lease to a new visibility timeout, counted from now -- a heartbeat for a caller still processing a message that expects to run longer than the original visibility timeout",
            "variables": [
              {
                "name": "provider",
                "text": "Queue provider: memory (default, volatile, in-process pub/sub + work queues), repository (durable, every command talks to the database directly, no server process), or sqs (durable, delegates to Amazon SQS via the aux4/queue-sqs plugin). Unknown or not-installed providers (including the reserved 'cloud' provider from aux4/queue-cloud) fail with an 'install aux4/queue-<provider>' error",
                "default": "memory",
                "options": [
                  "memory",
                  "repository",
                  "sqs",
                  "cloud"
                ]
              },
              {
                "name": "storage",
                "text": "Deprecated alias for --provider, kept for backward compatibility. --provider takes precedence when both are given",
                "default": ""
              },
              {
                "name": "db",
                "text": "Database path or libsql:// URL, only used when --storage repository",
                "default": ".queue.db"
              },
              {
                "name": "port",
                "text": "Server port (memory storage only)",
                "default": "8420"
              },
              {
                "name": "token",
                "text": "Authentication token (memory storage only)",
                "default": ""
              },
              {
                "name": "name",
                "text": "Queue name",
                "default": ""
              },
              {
                "name": "leaseId",
                "text": "The leaseId returned by 'queue lease' (memory storage only)",
                "default": ""
              },
              {
                "name": "id",
                "text": "The message id returned by 'queue lease' (repository storage only)",
                "default": ""
              },
              {
                "name": "visibility",
                "text": "New visibility timeout in seconds, counted from now (required)",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "ack",
          "execute": [
            "set:provider=nvl(storage, provider)",
            "nout:aux4 queue value(provider) --help > /dev/null 2>&1; echo $?",
            "set:providerOk=${response}",
            "if(providerOk!=0) && echo 'Error: queue provider 'value(provider)' is not installed or unknown. Run: aux4 aux4 pkger install aux4/queue-'value(provider)' (or use --provider memory|repository|sqs).' >&2 && exit 1 || true",
            "aux4 queue value(provider) ack param(port) param(token) param(name) param(leaseId) param(id) param(db)"
          ],
          "help": {
            "text": "Acknowledge (complete) a leased message, removing it from the queue",
            "variables": [
              {
                "name": "provider",
                "text": "Queue provider: memory (default, volatile, in-process pub/sub + work queues), repository (durable, every command talks to the database directly, no server process), or sqs (durable, delegates to Amazon SQS via the aux4/queue-sqs plugin). Unknown or not-installed providers (including the reserved 'cloud' provider from aux4/queue-cloud) fail with an 'install aux4/queue-<provider>' error",
                "default": "memory",
                "options": [
                  "memory",
                  "repository",
                  "sqs",
                  "cloud"
                ]
              },
              {
                "name": "storage",
                "text": "Deprecated alias for --provider, kept for backward compatibility. --provider takes precedence when both are given",
                "default": ""
              },
              {
                "name": "db",
                "text": "Database path or libsql:// URL, only used when --storage repository",
                "default": ".queue.db"
              },
              {
                "name": "port",
                "text": "Server port (memory storage only)",
                "default": "8420"
              },
              {
                "name": "token",
                "text": "Authentication token (memory storage only)",
                "default": ""
              },
              {
                "name": "name",
                "text": "Queue name",
                "default": ""
              },
              {
                "name": "leaseId",
                "text": "The leaseId returned by 'queue lease' (memory storage only)",
                "default": ""
              },
              {
                "name": "id",
                "text": "The message id returned by 'queue lease' (repository storage only)",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "nack",
          "execute": [
            "set:provider=nvl(storage, provider)",
            "nout:aux4 queue value(provider) --help > /dev/null 2>&1; echo $?",
            "set:providerOk=${response}",
            "if(providerOk!=0) && echo 'Error: queue provider 'value(provider)' is not installed or unknown. Run: aux4 aux4 pkger install aux4/queue-'value(provider)' (or use --provider memory|repository|sqs).' >&2 && exit 1 || true",
            "aux4 queue value(provider) nack param(port) param(token) param(name) param(leaseId) param(id) param(db)"
          ],
          "help": {
            "text": "Release a leased message for immediate redelivery, incrementing its attempts; the message becomes a dead-letter (visible via 'queue dlq', no longer leasable) once maxAttempts is reached",
            "variables": [
              {
                "name": "provider",
                "text": "Queue provider: memory (default, volatile, in-process pub/sub + work queues), repository (durable, every command talks to the database directly, no server process), or sqs (durable, delegates to Amazon SQS via the aux4/queue-sqs plugin). Unknown or not-installed providers (including the reserved 'cloud' provider from aux4/queue-cloud) fail with an 'install aux4/queue-<provider>' error",
                "default": "memory",
                "options": [
                  "memory",
                  "repository",
                  "sqs",
                  "cloud"
                ]
              },
              {
                "name": "storage",
                "text": "Deprecated alias for --provider, kept for backward compatibility. --provider takes precedence when both are given",
                "default": ""
              },
              {
                "name": "db",
                "text": "Database path or libsql:// URL, only used when --storage repository",
                "default": ".queue.db"
              },
              {
                "name": "port",
                "text": "Server port (memory storage only)",
                "default": "8420"
              },
              {
                "name": "token",
                "text": "Authentication token (memory storage only)",
                "default": ""
              },
              {
                "name": "name",
                "text": "Queue name",
                "default": ""
              },
              {
                "name": "leaseId",
                "text": "The leaseId returned by 'queue lease' (memory storage only)",
                "default": ""
              },
              {
                "name": "id",
                "text": "The message id returned by 'queue lease' (repository storage only)",
                "default": ""
              },
              {
                "name": "attempts",
                "text": "Deprecated, ignored (repository storage only). The attempts counter is now bumped server-side via aux4/repository's 'patch --increment'; kept for backward compatibility with existing scripts",
                "default": "0"
              },
              {
                "name": "maxAttempts",
                "text": "The queue's maxAttempts, as set on 'queue create' (repository storage only; 0 means unlimited; only used to decide whether the message is now dead-lettered)",
                "default": "0"
              }
            ]
          }
        },
        {
          "name": "dlq",
          "execute": [
            "set:provider=nvl(storage, provider)",
            "nout:aux4 queue value(provider) --help > /dev/null 2>&1; echo $?",
            "set:providerOk=${response}",
            "if(providerOk!=0) && echo 'Error: queue provider 'value(provider)' is not installed or unknown. Run: aux4 aux4 pkger install aux4/queue-'value(provider)' (or use --provider memory|repository|sqs).' >&2 && exit 1 || true",
            "aux4 queue value(provider) dlq param(port) param(token) param(name) param(maxAttempts) param(db)"
          ],
          "help": {
            "text": "List the dead-letter messages for a work queue",
            "variables": [
              {
                "name": "provider",
                "text": "Queue provider: memory (default, volatile, in-process pub/sub + work queues), repository (durable, every command talks to the database directly, no server process), or sqs (durable, delegates to Amazon SQS via the aux4/queue-sqs plugin). Unknown or not-installed providers (including the reserved 'cloud' provider from aux4/queue-cloud) fail with an 'install aux4/queue-<provider>' error",
                "default": "memory",
                "options": [
                  "memory",
                  "repository",
                  "sqs",
                  "cloud"
                ]
              },
              {
                "name": "storage",
                "text": "Deprecated alias for --provider, kept for backward compatibility. --provider takes precedence when both are given",
                "default": ""
              },
              {
                "name": "db",
                "text": "Database path or libsql:// URL, only used when --storage repository",
                "default": ".queue.db"
              },
              {
                "name": "port",
                "text": "Server port (memory storage only)",
                "default": "8420"
              },
              {
                "name": "token",
                "text": "Authentication token (memory storage only)",
                "default": ""
              },
              {
                "name": "name",
                "text": "Queue name",
                "default": ""
              },
              {
                "name": "maxAttempts",
                "text": "The queue's maxAttempts, as set on 'queue create' (repository storage only; 0 means unlimited)",
                "default": "0"
              }
            ]
          }
        }
      ]
    },
